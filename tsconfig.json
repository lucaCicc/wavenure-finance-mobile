{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "baseUrl": ".",
        "jsx": "react-native",
        "moduleResolution": "bundler",
        "strict": true,
        "paths": {
            "@api/*": ["./src/api/*"],
            "@components/*": ["./src/components/*"],
            "@providers/*": ["./src/providers/*"],
            "@containers/*": ["./src/containers/*"],
            "@navigation/*": ["./src/navigation/*"],
            "@screens/*": ["./src/screens/*"],
            "@config/*": ["./src/config/*"],
            "@helper/*": ["./src/helpers/*"],
            "@services/*": ["./src/services/*"],
            "@hooks/*": ["./src/hooks/*"],
            "@styles/*": ["./src/styles/*"],
            "@common/*": ["./src/common/*"],
            "@model/*": ["./src/models/*"],
            "@store/*": ["./src/store/*"],
            "@mocks/*": ["./src/mocks/*"],
            "@assets/*": ["./src/assets/*"],
            "@utils/*": ["./src/utils/*"],
            "@core/*": ["./src/core/*"],
            "@/*": ["./src/*"]
        }
    },
    "include": [
        "./types/**/*",
        "./src/**/*.ts",
        "./src/**/*.tsx",
        "./e2e/**/*.ts",
        "app.config.ts"
    ],
    "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.js"]
}
